---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, AUTHOR_NAME, SITE_DESCRIPTION } from '../consts';
import PostList from '../components/PostList.astro';
import StreamFilter from '../components/StreamFilter.astro';
import { getAllPosts } from '../lib/posts';

// Combined firehose: all three streams, reverse-chronological, badged.
const posts = await getAllPosts();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${AUTHOR_NAME} — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      .hero {
        padding: 3rem 0 2rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 2.5rem;
      }
      .hero h1 {
        font-size: 2.4rem;
        font-weight: 700;
        margin: 0 0 0.5rem;
        background: linear-gradient(120deg, var(--accent), var(--accent-3));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .hero .byline {
        color: var(--text);
        font-size: 1rem;
        font-weight: 600;
        margin: 0 0 0.75rem;
      }
      .hero .tagline {
        color: var(--text-muted);
        font-size: 1rem;
        margin: 0 0 1.25rem;
        line-height: 1.6;
      }
      .posts-heading {
        font-size: 1.125rem;
        font-weight: 600;
        margin: 0 0 1.25rem;
        color: var(--heading);
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="hero">
        <h1>{SITE_TITLE}</h1>
        <p class="byline">{AUTHOR_NAME}</p>
        <p class="tagline">
          Engineering notes from Melbourne — mine, plus the dev blogs my AI
          collaborators write from inside two of my side projects.
        </p>
      </div>

      <p class="posts-heading">Writing</p>
      <StreamFilter />
      <PostList posts={posts} showBadges={true} />
    </main>
    <Footer />
  </body>
</html>