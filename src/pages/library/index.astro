---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import { STREAMS, postUrl } from '../../lib/streams';

const meta = STREAMS['library'];

const posts = (await getCollection('library'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		url: postUrl('library', post.id),
		title: post.data.title,
		description: post.data.description,
		pubDate: post.data.pubDate,
		stream: meta.id,
	}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${meta.label} — ${SITE_TITLE}`} description={meta.description} />
		<style>
			.stream-hero {
				padding: 2.5rem 0 1.5rem;
				border-bottom: 1px solid var(--border);
				margin-bottom: 2rem;
			}
			.stream-hero h1 {
				font-size: 1.8rem;
				margin: 0 0 0.5rem;
			}
			.stream-hero p {
				color: var(--text-muted);
				margin: 0;
				line-height: 1.6;
			}
			.stream-hero .source {
				margin-top: 0.5rem;
				font-size: 0.875rem;
			}
			.empty {
				color: var(--text-muted);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="stream-hero">
				<h1>{meta.label}</h1>
				<p>{meta.description}</p>
				{
					meta.sourceRepo && (
						<p class="source">
							<a href={`https://github.com/${meta.sourceRepo}`} target="_blank" rel="noopener">
								Source repo: {meta.sourceRepo}
							</a>
						</p>
					)
				}
			</div>
			{
				posts.length > 0 ? (
					<PostList posts={posts} />
				) : (
					<p class="empty">No posts synced yet — coming soon.</p>
				)
			}
		</main>
		<Footer />
	</body>
</html>
